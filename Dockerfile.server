# Imagen del API de CoffeeTrace.
FROM node:20-alpine

WORKDIR /app

# Las dependencias se copian aparte para que la capa se cachee mientras el
# package.json no cambie.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Corre como usuario sin privilegios en lugar de root.
USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "server/index.js"]
