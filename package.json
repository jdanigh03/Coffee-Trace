{
  "name": "coffeetrace-erp",
  "version": "1.0.0",
  "description": "Sistema ERP de trazabilidad de café con Hyperledger Fabric",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install",
    "db:check": "node scripts/migrate.js --check",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/migrate.js --reset --load",
    "db:etl": "python scripts/etl_excel.py && python scripts/etl_beneficio.py",
    "test:traza": "node scripts/test_trazabilidad.js",
    "worker": "node server/worker/sellador.js",
    "worker:once": "node server/worker/sellador.js --una-vuelta",
    "chaincode:build": "cd blockchain/chaincode && npm run build",
    "fabric:up": "cd blockchain/network && docker compose up -d",
    "fabric:down": "cd blockchain/network && docker compose down -v"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
