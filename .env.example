# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffeetrace
DB_USER=postgres
DB_PASSWORD=password

# Hyperledger Fabric
# Cliente: @hyperledger/fabric-gateway (NO fabric-network, que se quedo en 2.2)
FABRIC_ENDPOINT=localhost:7051
FABRIC_HOST_ALIAS=peer0.asocafe.coffeetrace.bo
FABRIC_MSPID=AsocafeMSP
FABRIC_CHANNEL=trazabilidad
FABRIC_CHAINCODE=trazabilidad
FABRIC_TLS_CERT=./blockchain/organizations/peerOrganizations/asocafe.coffeetrace.bo/peers/peer0.asocafe.coffeetrace.bo/tls/ca.crt
FABRIC_CERT=./blockchain/organizations/peerOrganizations/asocafe.coffeetrace.bo/users/Admin@asocafe.coffeetrace.bo/msp/signcerts/cert.pem
FABRIC_KEY=./blockchain/organizations/peerOrganizations/asocafe.coffeetrace.bo/users/Admin@asocafe.coffeetrace.bo/msp/keystore/priv_sk

# Worker de sellado
WORKER_INTERVALO_MS=10000
WORKER_LOTE_MAX=25
WORKER_MAX_INTENTOS=5

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# API
API_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Supabase - cliente (frontend). Solo lee datos, sujeto a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase - base de datos. SOLO backend, nunca en el frontend.
# La clave publishable de arriba NO sirve aqui: no puede crear tablas.
#
# HAY DOS CADENAS Y NO SON INTERCAMBIABLES:
#
# 1) LOCAL, para migraciones y carga -> conexion directa, puerto 5432
#    postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#    El DDL necesita este puerto; el transaction pooler no lo maneja bien.
#
# 2) VERCEL, para el API en produccion -> transaction pooler, puerto 6543
#    postgresql://postgres.<ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
#    La cadena directa NO sirve en Vercel: db.<ref>.supabase.co resuelve solo
#    a IPv6 y las funciones serverless son IPv4. Ademas el pooler evita que
#    cada invocacion abra una conexion nueva y agote el limite.
#
# La del pooler sale del boton "Connect" del panel de Supabase.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

