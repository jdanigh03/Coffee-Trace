# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffeetrace
DB_USER=postgres
DB_PASSWORD=password

# Hyperledger Fabric
FABRIC_NETWORK=coffeetrace-network
FABRIC_CHANNEL=coffeetrace-channel
FABRIC_CHAINCODE=coffeetrace
FABRIC_MSPID=CoffeeTraceMSP
FABRIC_KEYSTORE=./wallet/keystore
FABRIC_CONNECTION_PROFILE=./fabric-config/connection-profile.json

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# API
API_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
